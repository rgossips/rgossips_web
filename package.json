{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:int": "jest --config jest.integration.config.mjs",
    "test:deno": "deno test --allow-net --no-check __deno__/",
    "test:findings": "jest --config jest.findings.config.mjs",
    "test:mutation": "stryker run",
    "lint:security": "eslint --config eslint.security.config.mjs",
    "qa:checks": "node qa/checks/rls-on-new-tables.mjs && node qa/checks/bundle-secrets.mjs",
    "qa:gate": "npm run test && npm run test:deno && npm run qa:checks",
    "qa:report": "npm run test:int && npm run test:findings"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
