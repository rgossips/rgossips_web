    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^30.4.2",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^17.0.0",
    "sharp": "^0.35.1",
    "supabase": "^2.104.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  }
