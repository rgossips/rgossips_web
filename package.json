    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "^16.0.7",
    "next-intl": "^4.13.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.67.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.13"
  },
